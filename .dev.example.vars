RIN_GITHUB_CLIENT_ID=<Github Client ID>
RIN_GITHUB_CLIENT_SECRET=<Github Client Secret>
JWT_SECRET=<JWT Secret, generate one at https://www.avast.com/random-password-generator>
S3_ACCESS_KEY_ID=<S3 Access Key ID>
S3_SECRET_ACCESS_KEY=<S3 Secret Access Key>
# 图片桶（图床/文章插图/favicon）
IMG_BUCKET=<YourImageBucket>
IMG_FOLDER=images/
IMG_ACCESS_HOST=<YourImageAccessHost>
# 文件桶（文件托管）
FILE_BUCKET=<YourFileBucket>
FILE_FOLDER=files/
FILE_ACCESS_HOST=<YourFileAccessHost>
# 缓存桶（RSS/SEO/配置缓存）
CACHE_BUCKET=<YourCacheBucket>
CACHE_FOLDER=cache/
CACHE_ACCESS_HOST=<YourCacheAccessHost>
